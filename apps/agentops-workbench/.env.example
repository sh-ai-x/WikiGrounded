# Copy to .env and fill in the values you need.
# Every var is read by src/agentops_workbench/settings.py via pydantic_settings
# (env_prefix = "AGENTOPS_"). Defaults shown below are applied when a var is unset.

# ---------- LLM provider ----------
# Pick one of: local-fake | openai | minimax
AGENTOPS_PROVIDER=local-fake
AGENTOPS_MODEL=MiniMax-M3

# Required when AGENTOPS_PROVIDER=minimax
AGENTOPS_MINIMAX_API_KEY=
AGENTOPS_MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Required when AGENTOPS_PROVIDER=openai
AGENTOPS_OPENAI_API_KEY=

# ---------- App / API ----------
AGENTOPS_APP_HOST=127.0.0.1
AGENTOPS_APP_PORT=8000

# JWT signing for the API. Rotate for any non-local deploy (>= 32 bytes recommended).
AGENTOPS_JWT_SECRET=dev-only-please-rotate
AGENTOPS_JWT_ALGORITHM=HS256
AGENTOPS_JWT_EXPIRY_SECONDS=3600

# ---------- Storage ----------
AGENTOPS_DATABASE_URL=sqlite:///./agentops.db
AGENTOPS_RUNS_DIR=./runs

# ---------- Document corpus (MCP document server) ----------
AGENTOPS_DOCS_DIR=fixtures/docs

# ---------- Local dev principal ----------
AGENTOPS_DEV_PRINCIPAL_ID=dev-user
